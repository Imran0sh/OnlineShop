---
import HeaderLink from "./HeaderLink.astro";
import search from "../assets/img/search.svg";
import HederSearch from "./catalog/HederSearch.tsx";
---

<header class="top-0 z-50 w-full border-b">
    <div class="flex items-center gap-6 px-75">
        <div class="flex flex-row items-center gap-2">
            <svg viewBox="0 0 16 16" width="25" height="25" aria-hidden="true">
                <path
                    fill="#25D366"
                    d="M8 0a8 8 0 0 0-6.86 12.12L0 16l3.99-1.04A8 8 0 1 0 8 0zm4.66 11.54c-.2.56-1.17 1.05-1.62 1.08-.42.03-.95.05-1.54-.14-.36-.12-.82-.27-1.41-.53-2.49-1.08-4.11-3.72-4.24-3.9-.13-.18-1.01-1.35-1.01-2.58 0-1.23.64-1.83.87-2.08.23-.26.5-.32.67-.32h.48c.15 0 .36-.06.56.42.2.48.68 1.66.74 1.78.06.12.1.26.02.42-.08.16-.12.26-.24.4-.12.14-.25.31-.36.42-.12.12-.24.25-.1.49.14.24.62 1.02 1.33 1.65.91.81 1.67 1.06 1.91 1.18.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.39.66 1.63.78.24.12.4.18.46.28.06.1.06.58-.14 1.14z"
                ></path>
            </svg>
            <a class="font-medium text-xl">+7 (777) xxx xxxx</a>
        </div>

        <div class="flex flex-row items-center gap-2">
            <svg viewBox="0 0 16 16" width="25" height="25" aria-hidden="true">
                <circle cx="8" cy="8" r="8" fill="#0191F2"></circle>
                <path
                    d="M3.87,3.78 C3.56,4.02 3.34,4.27 3.29,4.76 C3.24,5.24 3.16,5.85 3.56,6.71 C3.96,7.57 4.80,8.99 5.69,9.91 C6.58,10.83 8.12,11.76 8.89,12.22 C9.66,12.68 9.81,12.64 10.31,12.67 C10.81,12.70 11.49,12.61 11.87,12.40 C12.24,12.19 12.46,11.69 12.58,11.38 C12.70,11.07 12.70,10.75 12.58,10.53 C12.45,10.32 12.20,10.22 11.82,10.09 C11.44,9.96 10.69,9.69 10.31,9.73 C9.93,9.78 9.81,10.24 9.56,10.36 C9.30,10.47 9.17,10.53 8.80,10.40 C8.43,10.27 7.76,9.93 7.33,9.60 C6.90,9.27 6.52,8.86 6.22,8.44 C5.93,8.03 5.65,7.47 5.56,7.11 C5.46,6.76 5.54,6.54 5.64,6.31 C5.75,6.08 6.16,6.16 6.18,5.73 C6.19,5.31 5.90,4.19 5.73,3.78 C5.56,3.37 5.47,3.29 5.16,3.29 C4.84,3.29 4.18,3.53 3.87,3.78 Z"
                    fill="#FFFFFF"></path>
            </svg>
            <a class="font-medium text-xl">+7 (777) xxx xxxx</a>
        </div>
    </div>

    <div
        class="container flex flex-row items-center justify-between px-4 mx-auto p-2 sm:py-8 sm:px-20"
    >
        <div class="flex items-center">
            <a href="/" class="flex flex-col leading-none px-5">
                <h1 class="text-(--blue) text-2xl font-bold">VeloShop</h1>
            </a>
        </div>
        <div
            class="relative flex border rounded-4xl py-1 px-3 w-4/5 mx-auto items-center"
        >
            <HederSearch client:load />
            <div class="flex justify-end shrink-0">
                <img src={search.src} alt="Поиск" />
            </div>
        </div>
        {/* counter */}
        <div class=""></div>
    </div>

    <div
        class="[background-image:var(--gradient1)] flex flex-row items-center justify-center px-4 mx-auto p-2"
    >
        <nav class="hidden md:flex items-center">
            <div class="internal-links text-xl text-white flex gap-10">
                <HeaderLink href="/">Главная</HeaderLink>
                <HeaderLink href="/about">О нас</HeaderLink>
                <HeaderLink href="/blog">Наши работы</HeaderLink>
                <HeaderLink href="/catalog">Каталог</HeaderLink>
            </div>
        </nav>
    </div>
</header>
